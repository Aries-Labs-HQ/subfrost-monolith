# subfrost-monolith configuration (copy to .env; `init` writes the key line).
# .env is gitignored and must stay chmod 600 — it holds the signing key.

# --- secret (written by `node src/index.js init`; never commit, never print)
# MONOLITH_PRIVKEY_HEX=<64 hex chars>

# --- endpoints (defaults match a local signet stack)
# METASHREW_URL=http://127.0.0.1:8080
# BITCOIND_URL=http://127.0.0.1:38332
# BITCOIND_USER=bitcoinrpc
# BITCOIND_PASS=bitcoinrpc
# WATCH_WALLET=subfrost-monolith-watch

# --- safety knobs
# MIN_CONFIRMATIONS=2          receipt depth required before paying
# MAX_PAYOUT_SATS=10000000     single-payout cap (defer above this)
# MAX_SATS_PER_CYCLE=50000000  total payout budget per cycle
# FEE_RATE_SAT_VB=2            fallback fee rate when estimatesmartfee has no data
# MAX_FEE_RATE_SAT_VB=50       clamp on estimated fee rates
# REQUIRE_SIGNER_MATCH=false   true = defer receipts whose script != frBTC signer script
# DEEP_VERIFY=true             cross-check unwrap tx structure via esplora
# ESPLORA_URL=https://mempool.space/signet/api

# --- operation
# POLL_INTERVAL_SEC=30
# DATA_DIR=data
